PIXEL_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://pixel.example.invalid
DATABASE_URL=postgresql://pixel:change-me@db:5432/pixel
ADMIN_ENABLED=false
ADMIN_TOKEN=
LLM_PROVIDER=openai
STT_PROVIDER=openai
TTS_PROVIDER=openai
# Settings accepts these; the running API still uses the in-memory fixture index until postgres is wired in VoiceRuntime.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_STORE=postgres
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.08
OPENAI_API_KEY=
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid
TOOL_TIMEOUT_SECONDS=5
MAX_TOOL_CALLS_PER_TURN=2
