# Pixel environment template — copy to `.env` for local use.
# Never put real API keys, passwords, or production credentials in this file.

# local | development | staging | production
PIXEL_ENV=local

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Local Compose default only. Not a production credential.
DATABASE_URL=postgresql://pixel:pixel_dev_only@localhost:5432/pixel

# Admin APIs fail closed unless ADMIN_ENABLED is true AND ADMIN_TOKEN is set.
# Production requires a token of at least 32 characters when admin is enabled.
ADMIN_ENABLED=false

# Provider adapters. Default is mock. Production must not use mock.
LLM_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
# Settings accepts these; VoiceRuntime currently always uses the in-memory fixture retriever.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=hash-bow-v1
EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_STORE=memory
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.08

# Leave empty in git. The API reads this only inside server-side adapters.
OPENAI_API_KEY=

# Phase 4 models (used when the matching *_PROVIDER is openai)
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
# Alias: PIXEL_TTS_VOICE=nova
STT_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=25
TTS_TIMEOUT_SECONDS=20
SESSION_TTL_SECONDS=1800
LLM_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.2
TOOL_TIMEOUT_SECONDS=5
MAX_TOOL_CALLS_PER_TURN=2

# Phase 8 — abuse controls and kill switches (in-process rate limits; not shared across replicas)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SESSION_PER_MINUTE=30
RATE_LIMIT_TURN_PER_MINUTE=120
RATE_LIMIT_TURN_PER_SESSION_PER_MINUTE=60
RATE_LIMIT_WS_PER_MINUTE=30
RATE_LIMIT_ADMIN_PER_MINUTE=20
MAX_REQUEST_BYTES=65536
MAX_WS_CONTROL_BYTES=8192
MAX_USER_CHARS=4000
TRUST_PROXY=false
TOOLS_ENABLED=true
DISABLED_TOOLS=
SIDE_EFFECTING_TOOLS_ENABLED=true
LLM_ENABLED=true
STT_ENABLED=true
TTS_ENABLED=true
KNOWLEDGE_ENABLED=true
ADMIN_TOKEN=

# Browser-safe public URL of the API. Never put provider secrets in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
